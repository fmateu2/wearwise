  "rules": {
    "color_matching": {
      "compatible_colors": {
        "black": ["white", "gray", "red", "navy_blue", "beige", "camel", "gold", "silver", "pink"],
        "white": ["black", "navy_blue", "beige", "gray", "green", "brown", "camel", "pink"],
        "gray": ["black", "white", "navy_blue", "yellow", "burgundy", "pink", "green"],
        "navy_blue": ["white", "gray", "camel", "yellow", "red", "pink"],
        "red": ["black", "white", "gray", "navy_blue", "camel"],

        "burgundy": ["black", "gray", "white", "beige", "mustard"],
        "dark_green": ["beige", "white", "brown", "black", "gray"],
        "light_green": ["white", "beige", "gray", "pastel"],
        "yellow": ["navy_blue", "gray", "black"],
        "mustard": ["black", "gray", "burgundy"],

        "beige": ["black", "white", "brown", "navy_blue", "green"],
        "camel": ["black", "white", "navy_blue", "pink"],
        "brown": ["beige", "white", "green", "camel"],
        "pink": ["gray", "white", "black", "beige"],
        "lilac": ["pastel", "white", "gray"],
        "orange": ["navy_blue", "black", "white"],
        "gold": ["black", "white", "burgundy"],
        "silver": ["black", "white", "gray"]
      }
    },

    "temperature_rules": {
      "rules": [
        {
          "name": "very_cold",
          "min": -50,
          "max": 5,
          "required": ["puffer jacket", "sweater", "scarf", "gloves", "boots"],
          "forbidden": ["shorts", "tank_top", "tshirt"]
        },
        {
          "name": "cold",
          "min": 6,
          "max": 12,
          "required": ["jacket", "light_sweater"],
          "forbidden": ["shorts", "tank_top", "tshirt"]
        },
        { "name": "mild", "min": 13, "max": 18, "required": ["shirt", "thin_sweater"] },
        {
          "name": "warm",
          "min": 19,
          "max": 26,
          "required": ["tshirt", "light_pants"],
          "forbidden": ["puffer jacket", "coat"]
        },
        {
          "name": "hot",
          "min": 27,
          "max": 60,
          "required": ["tank_top", "shorts", "sandals"],
          "forbidden": ["outerwear"]
        }
      ]
    },

    "pattern_rules": {
      "solid": ["stripes", "plaid", "floral", "graphic"],
      "stripes": ["solid", "small_flower"],
      "plaid": ["solid"],
      "floral": ["solid"],
      "animal_print": ["solid"]
    },

    "formality_rules": {
      "formal": {
        "allowed": ["shirt", "blazer", "dress_pants", "formal_shoes"],
        "forbidden": ["tshirt", "jeans", "sneakers", "shorts", "sandals", "leggings"]
      },
      "business_casual": { "allowed": ["shirt", "polo", "chinos", "neutral_sneakers"] },
      "casual": { "allowed": ["tshirt", "jeans", "sneakers"] }
    },

    "occasion_rules": {
      "work": {
        "forbidden_styles": ["sport"]
      },
      "date": {
        "forbidden_styles": ["sport"]
      },
      "sport": {
        "forbidden_styles": ["formal"],
        "allowed": ["sport_shirt", "leggings", "sport_shoes"],
        "forbidden": ["jeans"]
      }
    },

    "category_matching": {
      "basic_outfit": ["top", "bottom", "shoes"],
      "formal_outfit": ["shirt", "dress_pants", "formal_shoes"],
      "casual_outfit": ["tshirt", "jeans", "sneakers"],
      "winter_outfit": ["top", "bottom", "outerwear", "shoes"]
    }
  }
